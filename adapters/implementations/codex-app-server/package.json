{
  "name": "@makaio/ai-adapters-codex-app-server",
  "description": "OpenAI Codex App-Server adapter for the Makaio AI framework.",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas": "./src/bus/schemas.ts",
    "./register": "./src/bus/register.ts",
    "./server": "./src/server.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsx build.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/ai-adapters-stream-session": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/clients-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/utils": "workspace:*",
    "p-queue": "^9.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "vite": "^8.0.0",
    "vitest": "4.1.5"
  }
}
