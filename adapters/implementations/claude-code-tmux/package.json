{
  "name": "@makaio/adapter-claude-code-tmux",
  "description": "Claude Code tmux adapter for the Makaio framework.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "adapters/implementations/claude-code-tmux"
  },
  "bugs": {
    "url": "https://github.com/makaio-ai/makaio-framework/issues"
  },
  "homepage": "https://github.com/makaio-ai/makaio-framework#readme",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@makaio/framework": "^1.0.0"
  },
  "devDependencies": {
    "@makaio/ai-adapters-claude-process-shared": "workspace:*",
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/ai-adapters-stream-session": "workspace:*",
    "@makaio/build-tooling": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/client-claude-code": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/subsystem-client": "workspace:*",
    "@makaio/subsystem-native-session-supervisor": "workspace:*",
    "@makaio/utils": "workspace:*",
    "@types/node": "^26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
