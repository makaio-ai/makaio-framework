{
  "name": "claude-code-tmux",
  "displayName": "Claude Code (tmux)",
  "version": "0.1.0",
  "makaio": {
    "framework": ">=0.1.0"
  },
  "dependencies": [
    {
      "type": "extension",
      "name": "provider-anthropic",
      "version": ">=0.1.0"
    },
    {
      "type": "extension",
      "name": "claude-code",
      "version": ">=0.1.0"
    },
    {
      "type": "extension",
      "name": "client-hooks",
      "version": ">=0.1.0"
    },
    {
      "type": "extension",
