{
  "name": "@makaio/ai-adapters-gemini-sdk",
  "version": "0.1.0",
  "description": "Gemini SDK adapter for Makaio AI framework",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": "./src/server.ts"
  },
  "private": true,
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx src/test-run.ts",
    "test": "echo 'ERROR: Tests must be run via `yarn test` from repository root!' && exit 1",
    "lint": "echo 'ERROR: Run `yarn validate path/to/package` from repository root instead!' && exit 1"
  },
  "dependencies": {
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/ai-adapters-stream-session": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/utils": "workspace:*",
    "p-queue": "^9.0.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@google/gemini-cli-core": ">=0.29.5",
    "@google/genai": ">=1.42.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.14.1",
    "@google/gemini-cli": "0.29.5",
    "@google/gemini-cli-core": "0.36.0",
    "@google/genai": "1.48.0",
    "@makaio/build-tooling": "workspace:*",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "vite": "^8.0.0",
    "vitest": "*"
  }
}
