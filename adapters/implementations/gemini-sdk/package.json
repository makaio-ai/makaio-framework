{
  "name": "@makaio/adapter-gemini-sdk",
  "version": "1.0.0",
  "description": "Gemini SDK adapter for Makaio AI framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "adapters/implementations/gemini-sdk"
  },
  "bugs": {
    "url": "https://github.com/makaio-ai/makaio-framework/issues"
  },
  "homepage": "https://github.com/makaio-ai/makaio-framework#readme",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "dev": "tsx src/test-run.ts",
    "test": "vitest run",
    "lint": "echo 'ERROR: Run `yarn validate path/to/package` from repository root instead!' && exit 1"
  },
  "dependencies": {
    "p-queue": "^9.3.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@google/gemini-cli-core": ">=0.29.5 <0.40.0",
    "@google/genai": ">=1.42.0 <2.0.0",
    "@makaio/framework": "^1.0.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.21.0",
    "@google/gemini-cli": "0.43.0",
    "@google/gemini-cli-core": "0.43.0",
    "@google/genai": "1.48.0",
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/ai-adapters-stream-session": "workspace:*",
    "@makaio/build-tooling": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/utils": "workspace:*",
    "@types/node": "^24.3.0",
    "tsx": "^4.22.3",
    "vitest": "4.1.7"
  },
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
