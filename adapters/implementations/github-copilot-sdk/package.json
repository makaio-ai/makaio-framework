{
  "name": "@makaio/adapter-github-copilot-sdk",
  "description": "GitHub Copilot SDK adapter for the Makaio AI framework.",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "adapters/implementations/github-copilot-sdk"
  },
  "bugs": {
    "url": "https://github.com/makaio-ai/makaio-framework/issues"
  },
  "homepage": "https://github.com/makaio-ai/makaio-framework#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx src/agent.ts",
    "test": "echo 'ERROR: Tests must be run via `yarn test` from repository root!' && exit 1",
    "test:watch": "vitest",
    "runner": "tsx src/runner.ts"
  },
  "dependencies": {
    "p-defer": "^4.0.1",
    "p-queue": "^9.0.0",
    "quick-lru": "^7.3.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@github/copilot-sdk": "^0.2.2",
    "@makaio/framework": "^0.1.0"
  },
  "devDependencies": {
    "@github/copilot-sdk": "0.2.2",
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/ai-adapters-stream-session": "workspace:*",
    "@makaio/build-tooling": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/clients-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/utils": "workspace:*",
    "@types/node": "^24.3.0",
    "openai": "^6.34.0",
    "tsx": "^4.20.5",
    "vite": "^8.0.0",
    "vitest": "*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
