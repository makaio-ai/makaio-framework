{
  "name": "@makaio/adapter-claude-agent-sdk",
  "description": "Claude Agent SDK adapter using the three-layer architecture.",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "adapters/implementations/claude-agent-sdk"
  },
  "bugs": {
    "url": "https://github.com/makaio-ai/makaio-framework/issues"
  },
  "homepage": "https://github.com/makaio-ai/makaio-framework#readme",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "dev": "tsx src/test-run.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@makaio/client-claude-code": "workspace:*",
    "p-defer": "^4.0.1",
    "p-queue": "^9.3.1",
    "zod": "4.4.3"
  },
  "publishWorkspaceDependencies": [
    "@makaio/client-claude-code"
  ],
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.50",
    "@makaio/framework": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.131",
    "@makaio/ai-adapters-claude-process-shared": "workspace:*",
    "@makaio/ai-adapters-claude-shared": "workspace:*",
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/build-tooling": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/framework": "workspace:*",
    "@makaio/subsystem-client": "workspace:*",
    "@makaio/utils": "workspace:*",
    "@types/node": "^24.3.0",
    "tsx": "^4.23.1"
  },
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
