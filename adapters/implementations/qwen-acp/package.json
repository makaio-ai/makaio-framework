{
  "name": "@makaio/adapter-qwen-acp",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "adapters/implementations/qwen-acp"
  },
  "bugs": {
    "url": "https://github.com/makaio-ai/makaio-framework/issues"
  },
  "homepage": "https://github.com/makaio-ai/makaio-framework#readme",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@makaio/framework": "^1.0.0"
  },
  "devDependencies": {
    "@makaio/ai-adapters-acp-client": "workspace:*",
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/build-tooling": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/subsystem-client": "workspace:*",
    "@makaio/utils": "workspace:*",
    "@types/node": "^24.3.0",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
