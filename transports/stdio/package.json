{
  "name": "@makaio/bus-transport-stdio",
  "description": "Stdio JSONL transport for @makaio/bus-core enabling cross-process bus communication.",
  "version": "0.0.1",
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@makaio/bus-core": "workspace:*",
    "@makaio/subprocess": "workspace:*"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@types/node": "^24.3.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
