{
  "name": "@makaio/ui-kernel",
  "description": "TypeScript contracts, registries, and schemas for framework UI packages.",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./pages/namespace": "./src/pages/namespace.ts",
    "./pages/schemas": "./src/pages/schemas.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/kernel": "workspace:*",
    "@makaio/utils": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "tsdown": "0.22.4"
  },
  "inlinedDependencies": {
    "type-fest": "5.3.1"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./pages/namespace": "./dist/pages/namespace.mjs",
      "./pages/schemas": "./dist/pages/schemas.mjs",
      "./package.json": "./package.json"
    }
  }
}
