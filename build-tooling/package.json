{
  "name": "@makaio/build-tooling",
  "version": "1.0.0",
  "description": "Shared Vite build configuration for extensions and adapters",
  "type": "module",
  "private": true,
  "exports": {
    "./base": {
      "source": "./vite.base.ts",
      "default": "./vite.base.ts"
    },
    "./plugin": {
      "source": "./vite.plugin.ts",
      "default": "./vite.plugin.ts"
    },
    "./adapter": {
      "source": "./vite.adapter.ts",
      "default": "./vite.adapter.ts"
    },
    "./browser-shared-externals": {
      "source": "./browser-shared-externals.ts",
      "default": "./browser-shared-externals.ts"
    },
    "./rolldown-plugin-framework-externals": {
      "source": "./tsdown-framework-preset.ts",
      "default": "./tsdown-framework-preset.ts"
    },
    "./tsdown-framework-preset": {
      "source": "./tsdown-framework-preset.ts",
      "default": "./tsdown-framework-preset.ts"
    },
    "./tsdown-extension-preset": {
      "source": "./tsdown-extension-preset.ts",
      "default": "./tsdown-extension-preset.ts"
    },
    "./tsdown-adapter-preset": {
      "source": "./tsdown-adapter-preset.ts",
      "default": "./tsdown-adapter-preset.ts"
    },
    "./framework-public-surface": {
      "source": "./framework-public-surface.ts",
      "default": "./framework-public-surface.ts"
    },
    "./framework-import-map": {
      "source": "./framework-import-map.ts",
      "default": "./framework-import-map.ts"
    },
    "./framework-import-rewrite-plugin": {
      "source": "./framework-import-rewrite-plugin.ts",
      "default": "./framework-import-rewrite-plugin.ts"
    },
    "./portable-package": {
      "source": "./portable-package.ts",
      "default": "./portable-package.ts"
    },
    "./package-exports": {
      "source": "./package-exports.ts",
      "default": "./package-exports.ts"
    },
    "./process-env": {
      "source": "./process-env.ts",
      "default": "./process-env.ts"
    },
    "./tsdown-scss": {
      "source": "./tsdown-scss.ts",
      "default": "./tsdown-scss.ts"
    },
    "./tsgo-declarations": {
      "source": "./tsgo-declarations.ts",
      "default": "./tsgo-declarations.ts"
    }
  },
  "dependencies": {
    "tsdown": "0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "sass": "^1.100.0"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "^6.0.1"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": {
      "optional": true
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run"
  }
