{
  "name": "@makaio/runtime-node",
  "description": "Node.js runtime composition root for Makaio framework hosts.",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "runtimes/node"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client-binary-strategy-dependencies": "./src/client-binary-strategy-dependencies.ts",
    "./extension-discovery": "./src/extension-discovery.ts",
    "./extension-validation": "./src/extension-validation.ts",
    "./makaio-config": "./src/makaio-config.ts",
    "./runtime/schemas": "./src/bus/runtime/schemas.ts",
    "./runtime/namespace": "./src/bus/runtime/namespace.ts",
    "./workflow-execution-bus-access": "./src/workflow-execution-bus-access.ts",
    "./workflow-worker": "./src/workflow-worker/index.ts",
    "./workflow-worker/worker-entry": "./src/workflow-worker/worker-entry.ts",
    "./code-execution": "./src/code-execution/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/bus-server": "workspace:*",
    "@makaio/bus-transport-stdio": "workspace:*",
    "@makaio/bus-transport-websocket": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/kernel": "workspace:*",
    "@makaio/machine-identity": "workspace:*",
    "@makaio/platform-macos": "workspace:*",
    "@makaio/preferences": "workspace:*",
    "@makaio/providers": "workspace:*",
    "@makaio/service-base": "workspace:*",
    "@makaio/services-core": "workspace:*",
    "@makaio/services-log-import": "workspace:*",
    "@makaio/services-package-manager": "workspace:*",
    "@makaio/storage-drizzle": "workspace:*",
    "@makaio/storage-migrations": "workspace:*",
    "@makaio/subprocess": "workspace:*",
    "@makaio/subsystem-adapter": "workspace:*",
    "@makaio/subsystem-client": "workspace:*",
    "@makaio/subsystem-mcp-http-server": "workspace:*",
    "@makaio/subsystem-workflow-engine": "workspace:*",
    "@makaio/tools-core": "workspace:*",
    "@makaio/utils": "workspace:*",
    "drizzle-orm": "0.45.2",
    "execa": "^9.5.2",
    "glob": "13.0.6",
    "hono": "^4.12.23",
    "minimatch": "^10.0.3",
    "piscina": "^5.1.4",
    "tsx": "^4.22.3",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@makaio/framework": "workspace:*"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@makaio/framework": "workspace:*",
    "@makaio/test-utils": "workspace:*",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./client-binary-strategy-dependencies": {
        "types": "./dist/client-binary-strategy-dependencies.d.ts",
        "default": "./dist/client-binary-strategy-dependencies.mjs"
      },
      "./extension-discovery": {
        "types": "./dist/extension-discovery.d.ts",
        "default": "./dist/extension-discovery.mjs"
      },
      "./extension-validation": {
        "types": "./dist/extension-validation.d.ts",
        "default": "./dist/extension-validation.mjs"
      },
      "./makaio-config": {
        "types": "./dist/makaio-config.d.ts",
        "default": "./dist/makaio-config.mjs"
      },
      "./runtime/schemas": {
        "types": "./dist/bus/runtime/schemas.d.ts",
        "default": "./dist/bus/runtime/schemas.mjs"
      },
      "./runtime/namespace": {
        "types": "./dist/bus/runtime/namespace.d.ts",
        "default": "./dist/bus/runtime/namespace.mjs"
      },
      "./workflow-execution-bus-access": {
        "types": "./dist/workflow-execution-bus-access.d.ts",
        "default": "./dist/workflow-execution-bus-access.mjs"
      },
      "./workflow-worker": {
        "types": "./dist/workflow-worker/index.d.ts",
        "default": "./dist/workflow-worker/index.mjs"
      },
      "./workflow-worker/worker-entry": {
        "types": "./dist/workflow-worker/worker-entry.d.ts",
        "default": "./dist/workflow-worker/worker-entry.mjs"
      },
      "./code-execution": {
        "types": "./dist/code-execution/index.d.ts",
        "default": "./dist/code-execution/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
