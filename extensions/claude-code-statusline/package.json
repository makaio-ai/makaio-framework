{
  "name": "@makaio/extension-claude-code-statusline",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "extensions/claude-code-statusline"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@makaio/framework": "^1.0.0"
  },
  "dependencies": {
    "@makaio/bus-core": "workspace:*",
    "@makaio/client-claude-code": "workspace:*",
    "@makaio/kernel": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@types/node": "^26.0.0",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  },
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.mjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT"
}
