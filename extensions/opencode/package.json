{
  "name": "@makaio/extension-opencode",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./browser": "./src/browser.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "extensions/opencode"
  },
  "peerDependencies": {
    "@makaio/framework": "^1.0.0"
  },
  "dependencies": {
    "@makaio/ai-adapters-core": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "type-fest": "^4.31.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@makaio/test-utils": "workspace:*",
    "tsdown": "0.22.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.7"
  },
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.mjs"
      }
    }
  },
  "license": "MIT"
}
