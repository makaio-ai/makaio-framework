{
  "name": "@makaio/extension-prompt",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "extensions/prompt"
  },
  "type": "module",
  "exports": {
    "./cli": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "bun ./scripts/run-with-mode.ts repo-dev vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@makaio/bus-core": "*",
    "@makaio/framework": "workspace:*"
  },
  "dependencies": {
    "@makaio/utils": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/framework": "workspace:*",
    "@makaio/kernel": "workspace:*",
    "@makaio/test-utils": "workspace:*",
    "tsdown": "0.22.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "unrun": "^0.3.0",
    "vitest": "4.1.10"
  },
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT"
}
