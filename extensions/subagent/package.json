{
  "name": "@makaio/extension-subagent",
  "description": "Subagent communication tool extension and state manager.",
  "version": "1.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "extensions/subagent"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/tools-core": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.7"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT"
}
