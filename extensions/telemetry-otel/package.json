{
  "name": "@makaio/extension-telemetry-otel",
  "description": "OpenTelemetry trace exporter extension for Makaio execution telemetry.",
  "version": "0.1.0",
  "types": "src/index.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "extensions/telemetry-otel"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./subjects": "./src/contracts/namespace.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/expression": "workspace:*",
    "@makaio/rules": "workspace:*",
    "@makaio/service-base": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.217.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@types/node": "^24.3.0",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./contracts": {
        "types": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/index.mjs"
      },
      "./subjects": {
        "types": "./dist/contracts/namespace.d.ts",
        "default": "./dist/contracts/namespace.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "license": "MIT"
}
