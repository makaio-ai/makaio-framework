{
  "name": "@makaio/extension-telemetry-langfuse",
  "description": "Langfuse trace exporter extension for Makaio execution telemetry.",
  "version": "0.1.0",
  "types": "src/index.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "extensions/telemetry-langfuse"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langfuse/otel": "^5.4.1",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/extension-telemetry-otel": "workspace:*",
    "@makaio/kernel": "workspace:*",
    "@makaio/service-base": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.217.0",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@types/node": "^24.3.0",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.7"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
