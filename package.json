{
  "name": "@makaio/framework-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Typed, bus-centric framework for building and orchestrating AI agents with tools, sessions, and events",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git"
  },
  "bugs": {
    "url": "https://github.com/makaio-ai/makaio-framework/issues"
  },
  "homepage": "https://github.com/makaio-ai/makaio-framework#readme",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module",
  "resolutions": {
    "@anthropic-ai/sdk": "0.94.0",
    "@github/copilot": "1.0.45",
    "@opentelemetry/exporter-prometheus": "0.217.0",
    "@opentelemetry/sdk-node": "0.217.0",
    "@tootallnate/once": "3.0.1",
    "devalue": "5.8.1",
    "hono": "4.12.18",
    "ip-address": "10.2.0",
    "protobufjs@npm:8.0.0": "npm:8.0.2",
    "protobufjs@npm:8.0.1": "npm:8.0.2",
    "systeminformation": "5.31.6"
  },
  "workspaces": [
    "build-tooling",
    "packages/**/*",
    "runtimes/*",
    "platforms/*",
    "adapters/**/*",
    "tools/*",
    "apps/*",
    "transports/*",
    "providers/*",
    "clients/*",
    "sdks/*",
    "extensions/*",
    "ui/*"
  ],
  "scripts": {
    "build": "bun packages/framework/build.ts",
    "build:framework": "bun packages/framework/build.ts",
    "build:framework:assemble": "bun scripts/verify-framework-dist.ts",
    "build:extensions": "bun scripts/build-extensions.ts",
    "docs:bus": "tsx scripts/analyze-bus-namespaces.ts --no-callsites -o docs/subjects/data/namespaces.json --summary && tsx scripts/generate-bus-docs.ts -i docs/subjects/data/namespaces.json -o docs/subjects --branch develop",
    "docs:bus:release": "tsx scripts/analyze-bus-namespaces.ts --no-callsites -o docs/subjects/data/namespaces.json --summary && tsx scripts/generate-bus-docs.ts -i docs/subjects/data/namespaces.json -o docs/subjects --branch main",
    "dev": "yarn workspace @makaio/electron dev:renderer",
    "dev:electron": "yarn workspace @makaio/electron dev",
    "test": "vitest run",
    "generate:sdk": "tsx scripts/generate-sdk-bindings.ts",
    "smoke:managed-binaries": "tsx scripts/smoke-managed-binaries.ts",
    "test:conformance": "tsx scripts/test-adapters.ts",
    "test:e2e": "yarn test:e2e:browser && yarn test:e2e:desktop && yarn test:e2e:cli && yarn test:e2e:electron && yarn test:e2e:electron-pw",
    "test:e2e:browser": "vitest run --config ui/vitest.browser.config.ts",
    "test:e2e:desktop": "vitest run --config e2e/desktop/vitest.config.ts",
    "test:e2e:cli": "vitest run --config apps/cli/vitest.e2e.config.ts",
    "test:e2e:electron": "vitest run --config apps/electron/vitest.e2e.config.ts",
    "test:e2e:electron-pw": "tsx e2e/run-electron-e2e.ts",
    "test:e2e:electron-pw:ui": "tsx e2e/run-electron-e2e.ts --ui",
    "test:sdk": "yarn test:sdk:typescript && yarn test:sdk:python && yarn test:sdk:rust",
    "test:sdk:typescript": "vitest run --config sdks/typescript/vitest.config.ts",
    "test:sdk:python": "PYTHONPATH=sdks/python/src python3 -m pytest sdks/python/tests",
    "test:sdk:rust": "cd sdks/rust && cargo test && cargo test --examples",
    "test:sdks": "vitest run --config sdks/vitest.e2e.config.ts",
    "validate": "tsx scripts/validate-build-surface.ts && yarn validate:sdk-codegen && tsx scripts/validate.ts --tsconfig tsconfig.json",
    "validate:prettier": "tsx scripts/validate.ts --fix --tool prettier",
    "validate:eslint": "tsx scripts/validate.ts --fix --tool eslint",
    "validate:stylelint": "tsx scripts/validate.ts --fix --tool stylelint",
    "validate:typescript": "tsx scripts/validate.ts --fix --tsconfig tsconfig.json --tool typescript",
    "validate:sdk-codegen": "tsx scripts/generate-sdk-bindings.ts --check",
    "docs:dev": "yarn workspace @makaio/website dev",
    "docs:build": "yarn workspace @makaio/website build",
    "website:build": "yarn docs:bus && yarn workspace @makaio/website build",
    "website:build:release": "yarn docs:bus:release && yarn workspace @makaio/website build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "@hono/node-server": "^1.14.1",
    "@libsql/client": "^0.17.3",
    "emittery": "^1.2.0",
    "execa": "^9.5.2",
    "find-up": "^7.0.0",
    "glob": "13.0.6",
    "globby": "^14.1.0",
    "hono": "^4.12.18",
    "merge-anything": "^6.0.6",
    "p-defer": "^4.0.1",
    "p-queue": "^9.0.0",
    "strip-ansi": "^7.1.0",
    "tree-kill": "^1.2.2",
    "type-fest": "^5.2.0",
    "ws": "^8.18.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependenciesMeta": {
    "electron": {
      "built": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.36.0",
    "@makaio/build-tooling": "workspace:*",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@tsdown/css": "0.22.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "^4.0.18",
    "chalk": "^5.6.2",
    "drizzle-orm": "0.45.2",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^60.7.1",
    "eslint-plugin-tsdoc": "^0.4.0",
    "human-id": "^4.1.3",
    "jsdom": "^26.1.0",
    "knip": "^6.10.0",
    "minimatch": "^10.0.3",
    "playwright": "^1.57.0",
    "prettier": "3.7.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stylelint": "^16.26.1",
    "tsdown": "0.22.0",
    "tsx": "^4.20.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.12",
    "vitest": "4.1.5",
    "vitest-browser-react": "^2.0.4"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "printWidth": 120,
    "semi": true,
    "singleQuote": true
  }
}
