{
  "name": "@makaio/setup",
  "description": "Guided first-run setup flow for Makaio",
  "version": "0.0.0",
  "types": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/kernel": "workspace:*",
    "@makaio/services-package-manager": "workspace:*",
    "@makaio/utils": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@makaio/test-utils": "workspace:*",
    "@types/node": "^26.0.0",
    "tsdown": "0.22.0",
    "tsx": "^4.22.4",
    "vitest": "4.1.8"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
