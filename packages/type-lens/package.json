        "types": "./dist/index-query.d.ts",
        "default": "./dist/index-query.mjs"
      },
      "./index-types": {
        "types": "./dist/index-types.d.ts",
        "default": "./dist/index-types.mjs"
      },
      "./index-utils": {
        "types": "./dist/index-utils.d.ts",
        "default": "./dist/index-utils.mjs"
      },
      "./member-extractor": {
        "types": "./dist/member-extractor.d.ts",
