{
  "name": "@makaio/client-codex",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/package.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@makaio/framework": "^1.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/service-base": "workspace:*",
    "@makaio/subsystem-client": "workspace:*",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "descriptor.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "node_modules/.makaio-publish",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./runtime": {
        "types": "./dist/runtime/package.d.ts",
        "default": "./dist/runtime/package.mjs"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makaio-ai/makaio-framework.git",
    "directory": "clients/codex"
  },
  "license": "MIT"
}
