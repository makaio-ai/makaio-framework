{
  "name": "@makaio/storage-drizzle",
  "description": "Drizzle ORM extension for storage namespaces with a runtime SQLite client.",
  "version": "1.0.0",
  "types": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./columns/sqlite": "./src/columns/sqlite.ts",
    "./columns/postgres": "./src/columns/postgres.ts",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@makaio/storage-migrations": "workspace:*",
    "@types/node": "^26.0.0",
    "tsdown": "0.22.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/storage-core": "workspace:*",
    "@makaio/utils": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./client": "./dist/client.mjs",
      "./columns/sqlite": "./dist/columns/sqlite.mjs",
      "./columns/postgres": "./dist/columns/postgres.mjs",
      "./package.json": "./package.json"
    }
  },
  "inlinedDependencies": {
    "type-fest": "5.3.1",
    "zod": "4.3.5"
  },
  "license": "MIT"
}
