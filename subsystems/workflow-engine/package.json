{
  "name": "@makaio/subsystem-workflow-engine",
  "version": "1.0.0",
  "types": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./package": "./src/package.ts",
    "./workflow-orchestrator": "./src/workflow-orchestrator.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@makaio/bus-core": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/core": "workspace:*",
    "@makaio/expression": "workspace:*",
    "@makaio/service-base": "workspace:*",
    "@makaio/services-core": "workspace:*",
    "@makaio/storage-core": "workspace:*",
    "@makaio/storage-drizzle": "workspace:*",
    "@makaio/storage-handlers": "workspace:*",
    "ajv": "^8.18.0",
    "croner": "^9.0.0",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@makaio/build-tooling": "workspace:*",
    "@makaio/storage-migrations": "workspace:*",
    "@makaio/test-utils": "workspace:*",
    "@types/node": "^24.3.0",
    "tsdown": "0.22.0",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "publishConfig": {
