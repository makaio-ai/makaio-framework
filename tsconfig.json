{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "isolatedModules": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "baseUrl": ".",
    "rootDir": "./",
    "types": ["node", "vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@makaio/core": ["./packages/makaio-core/src/index.ts"],
      "@makaio/bus-core": ["./packages/bus-core/src/index.ts"],
      "@makaio/service-base": ["./packages/services/base/src/index.ts"],
      "@makaio/bus-transport-websocket": ["./transports/ws/src/index.ts"],
      "@makaio/bus-transport-message-channel": ["./transports/message-channel/src/index.ts"],
      "@makaio/bus-transport-stdio": ["./transports/stdio/src/index.ts"],
      "@makaio/bus-server": ["./packages/bus-server/src/index.ts"],
      "@makaio/bus-server-vite": ["./packages/bus-server-vite/src/index.ts"],
      "@makaio/utils": ["./packages/utils/src/index.ts"],
      "@makaio/ai-adapters-core": ["./adapters/core/src/index.ts"],
      "@makaio/ai-adapters-core/node": ["./adapters/core/src/node.ts"],
      "@makaio/ai-adapters-stream-session": ["./adapters/shared/stream-session/src/index.ts"],
      "@makaio/ai-adapters-acp-client": ["./adapters/shared/acp-client/src/index.ts"],
      "@makaio/kernel": ["./packages/kernel/src/index.ts"],
      "@makaio/kernel/cli/register": ["./packages/kernel/src/cli/register.ts"],
      "@makaio/kernel/cli/schemas": ["./packages/kernel/src/cli/schemas.ts"],
      "@makaio/kernel/*": ["./packages/kernel/src/*/index.ts"],
      "@makaio/runtime-node": ["./runtimes/node/src/index.ts"],
      "@makaio/runtime-node/runtime/schemas": ["./runtimes/node/src/bus/runtime/schemas.ts"],
      "@makaio/runtime-node/runtime/register": ["./runtimes/node/src/bus/runtime/namespace.ts"],
      "@makaio/tools-core": ["./tools/core/src/index.ts"],
      "@makaio/tools-core/testing": ["./tools/core/src/testing/index.ts"],
      "@makaio/tools-filesystem": ["./tools/filesystem/src/index.ts"],
      "@makaio/tools-subagent": ["./tools/subagent/src/index.ts"],
      "@makaio/tools-shell": ["./tools/shell/src/index.ts"],
      "@makaio/providers": ["./packages/providers/src/index.ts"],
      "@makaio/services/settings/namespace": ["./packages/services/core/src/settings/namespace.ts"],
      "@makaio/services/cli-detection/namespace": ["./packages/services/core/src/cli-detection/namespace.ts"],
      "@makaio/services-core": ["./packages/services/core/src/index.ts"],
      "@makaio/services-core/*": ["./packages/services/core/src/*/index.ts"],
      "@makaio/services-core/cli-detection/namespace": ["./packages/services/core/src/cli-detection/namespace.ts"],
      "@makaio/services-core/settings/namespace": ["./packages/services/core/src/settings/namespace.ts"],
      "@makaio/services-core/settings/storage/extension-configs/namespace": [
        "./packages/services/core/src/settings/storage/extension-configs/namespace.ts"
      ],
      "@makaio/services-core/session/storage/namespace": ["./packages/services/core/src/session/storage/namespace.ts"],
      "@makaio/services-core/session/messages/namespace": [
        "./packages/services/core/src/session/messages/namespace.ts"
      ],
      "@makaio/services-core/session/session-events/namespace": [
        "./packages/services/core/src/session/session-events/namespace.ts"
      ],
      "@makaio/services-core/session/testing": ["./packages/services/core/src/session/testing/index.ts"],
      "@makaio/services-core/session/handlers": ["./packages/services/core/src/session/handlers/index.ts"],
      "@makaio/services-core/session/orchestrator-testing": [
        "./packages/services/core/src/session/orchestrator-testing/index.ts"
      ],
      "@makaio/services-core/agent-runtime/schemas": ["./packages/services/core/src/agent-runtime/schemas.ts"],
      "@makaio/services-core/codebase/schemas": ["./packages/services/core/src/codebase/schemas.ts"],
      "@makaio/services-core/compression/schemas": ["./packages/services/core/src/compression/schemas.ts"],
      "@makaio/services-core/filesystem/schemas": ["./packages/services/core/src/filesystem/schemas.ts"],
      "@makaio/services-core/filesystem/namespace": ["./packages/services/core/src/filesystem/namespace.ts"],
      "@makaio/services-core/dialog/schemas": ["./packages/services/core/src/dialog/schemas.ts"],
      "@makaio/storage-core": ["./packages/storage/core/src/index.ts"],
      "@makaio/storage-drizzle": ["./packages/storage/drizzle/src/index.ts"],
      "@makaio/storage-handlers": ["./packages/storage/handlers/src/index.ts"],
      "@makaio/services-log-import": ["./packages/services/log-import/src/index.ts"],
      "@makaio/services-log-import/log-import": ["./packages/services/log-import/src/log-import.ts"],
      "@makaio/services-log-import/namespace": ["./packages/services/log-import/src/namespace.ts"],
      "@makaio/services-log-import/schemas": ["./packages/services/log-import/src/schemas.ts"],
      "@makaio/services-package-manager": ["./packages/services/package-manager/src/index.ts"],
      "@makaio/services-package-manager/package": ["./packages/services/package-manager/src/package.ts"],
      "@makaio/services-package-manager/schemas": ["./packages/services/package-manager/src/schemas.ts"],
      "@makaio/services-package-manager/namespace": ["./packages/services/package-manager/src/namespace.ts"],
      "@makaio/contracts": ["./packages/contracts/src/index.ts"],
      "@makaio/contracts/adapter": ["./packages/contracts/src/adapter/index.ts"],
      "@makaio/contracts/client": ["./packages/contracts/src/client/index.ts"],
      "@makaio/contracts/config": ["./packages/contracts/src/config/index.ts"],
      "@makaio/contracts/provider": ["./packages/contracts/src/provider/index.ts"],
      "@makaio/hooks": ["./packages/hooks/src/index.ts"],
      "@makaio/mcp-http-server": ["./packages/mcp-http-server/src/index.ts"],
      "@makaio/test-utils": ["./packages/test-utils/src/index.ts"],
      "@makaio/expression": ["./packages/expression/src/index.ts"],
      "@makaio/rules": ["./packages/rules/src/index.ts"],
      "@makaio/rules/schemas": ["./packages/rules/src/schemas.ts"],
      "@makaio/storage-migrations": ["./packages/storage-migrations/src/index.ts"],
      "@makaio/storage-migrations/apply-migrations": ["./packages/storage-migrations/src/apply-migrations.ts"],
      "@makaio/ui-theme": ["./ui/theme/index.scss"],
      "@makaio/ui-theme/*": ["./ui/theme/*"],
      "@makaio/ui-kernel": ["./ui/kernel/src/index.ts"],
      "@makaio/ui-kernel/pages/namespace": ["./ui/kernel/src/pages/namespace.ts"],
      "@makaio/ui-kernel/pages/schemas": ["./ui/kernel/src/pages/schemas.ts"],
      "@makaio/ui-kernel/*": ["./ui/kernel/src/*"],
      "@makaio/ui-components": ["./ui/components/src/index.ts"],
      "@makaio/ui-components/*": ["./ui/components/src/*"],
      "@makaio/ui-hooks": ["./ui/hooks/src/index.ts"],
      "@makaio/ui-hooks/*": ["./ui/hooks/src/*"],
      "@makaio/ui-views": ["./ui/views/src/index.ts"],
      "@makaio/ui-views/*": ["./ui/views/src/*"],
      "@makaio/preferences": ["./packages/preferences/src/index.ts"],
      "@makaio/preferences/browser": ["./packages/preferences/src/index.browser.ts"],
      "@makaio/preferences/package": ["./packages/preferences/src/package.ts"],
      "@makaio/native-session-supervisor": ["./packages/native-session-supervisor/src/index.ts"],
      "@makaio/native-session-supervisor/package": ["./packages/native-session-supervisor/src/package.ts"],
      "@makaio/extension-review": ["./extensions/review/src/index.ts"],
      "@makaio/extension-opencode": ["./extensions/opencode/src/index.ts"],
      "@makaio/extension-opencode/testing": ["./extensions/opencode/src/testing.ts"],
      "@makaio/extension-pin-message": ["./extensions/pin-message/src/index.ts"],
      "@makaio-community/account-manager": ["./extensions/account-manager/src/index.ts"],
      "@makaio-community/account-manager/schemas": ["./extensions/account-manager/src/bus/schemas.ts"],
      "@makaio-community/account-manager/register": ["./extensions/account-manager/src/bus/namespace.ts"],
      "@makaio/electron/schemas": ["./apps/electron/src/bus/schemas.ts"],
      "@makaio/electron/register": ["./apps/electron/src/bus/namespace.ts"],
      "@makaio/platform-macos": ["./platforms/macos/src/index.ts"]
    }
  },
  "include": ["./**/*"],
  "exclude": [
    "**/node_modules/**/*",
    "**/dist/**/*",
    "**/*.browser.test.ts",
    "**/*.browser.test.tsx",
    "./runtimes/node/src/__tests__/migrate-settings-to-sqlite.test.ts",
    "./packages/services/core/src/session/adapter-sessions/__tests__/**/*",
    "./packages/services/log-import/src/__tests__/**/*",
    "./extensions/loop/src/__tests__/**/*",
    // The validator preserves files with a nearer tsconfig, so account-manager
    // is still typechecked via framework/extensions/account-manager/tsconfig.json.
    "./extensions/account-manager/**/*",
    "./ui/vitest.browser.config.ts"
  ]
}
