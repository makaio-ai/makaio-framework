---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import { Icon, Badge } from '@astrojs/starlight/components';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

type SidebarEntry = StarlightRouteData['sidebar'][number];
type SidebarLink = Extract<SidebarEntry, { type: 'link' }>;

/**
 * Flattens a sidebar tree into its leaf links — inlined because Starlight does
 * not publicly export `flattenSidebar` from `utils/navigation`.
 * @param sidebar - Sidebar entries to flatten.
 * @returns Flat list of link entries.
 */
function flattenSidebar(sidebar: SidebarEntry[]): SidebarLink[] {
  return sidebar.flatMap((entry) => (entry.type === 'group' ? flattenSidebar(entry.entries) : entry));
}

interface Props {
  sublist: SidebarEntry[];
  nested?: boolean;
}

const { sublist, nested } = Astro.props;

/**
 * Within a nested autogenerated subtree, hoist groups above links so directory
 * entries (e.g. `implementations/`, `shared/`) are not interleaved with sibling
 * package pages (e.g. `core`). Top-level order is left alone — that's the
 * manual sidebar config from `astro.config.ts`.
 */
const orderedSublist =
  nested ?
    [...sublist].sort((a, b) => {
      const aIsGroup = a.type === 'group' ? 0 : 1;
      const bIsGroup = b.type === 'group' ? 0 : 1;
      return aIsGroup - bIsGroup;
    })
  : sublist;

/**
 * Acronyms / casing overrides for autogenerated sidebar group labels — Starlight
 * uses the literal directory name, but our `/packages/<area>/...` URLs are lowercase
 * and we want display labels like "UI" or "SDKs" instead of "Ui" / "Sdks".
 */
const GROUP_LABEL_OVERRIDES: Record<string, string> = {
  ai: 'AI',
  cli: 'CLI',
  sdks: 'SDKs',
  ui: 'UI',
  ws: 'WebSocket',
};

/**
 * Title-cases an autogenerated group label, honouring acronym overrides.
 * @param label - Raw label as Starlight derived it from the directory name.
 * @returns Display label for the sidebar group.
 */
function prettifyGroupLabel(label: string): string {
  const lower = label.toLowerCase();
  if (lower in GROUP_LABEL_OVERRIDES) return GROUP_LABEL_OVERRIDES[lower]!;
  if (label !== lower) return label;
  return label.charAt(0).toUpperCase() + label.slice(1);
}
---

<ul class:list={{ 'top-level': !nested }}>
  {
    orderedSublist.map((entry) => (
      <li>
        {entry.type === 'link' ? (
          <a
            href={entry.href}
            aria-current={entry.isCurrent ? 'page' : undefined}
            class:list={[{ large: !nested, 'two-line': Boolean(entry.attrs['data-description']) }, entry.attrs.class]}
            {...entry.attrs}
          >
            <span class="link-label">{entry.label}</span>
            {entry.attrs['data-description'] && <span class="link-description">{entry.attrs['data-description']}</span>}
            {entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
          </a>
        ) : (
          <details open={flattenSidebar(entry.entries).some((i) => i.isCurrent) || !entry.collapsed}>
            <summary>
              <span class="group-label">
                <span class="large">{prettifyGroupLabel(entry.label)}</span>
                {entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
              </span>
              <Icon name="right-caret" class="caret" size="1.25rem" />
            </summary>
            <SidebarRestorePoint />
            <Astro.self sublist={entry.entries} nested />
          </details>
        )}
      </li>
    ))
  }
</ul>

<style>
  @layer starlight.core {
    ul {
      --sl-sidebar-item-padding-inline: 0.5rem;
      list-style: none;
      padding: 0;
    }

    li {
      overflow-wrap: anywhere;
    }

    ul ul li {
      margin-inline-start: var(--sl-sidebar-item-padding-inline);
      border-inline-start: 1px solid var(--sl-color-hairline-light);
      padding-inline-start: var(--sl-sidebar-item-padding-inline);
    }

    .large {
      font-size: var(--sl-text-lg);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    .top-level > li + li {
      margin-top: 0.75rem;
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.2em var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
      cursor: pointer;
      user-select: none;
    }
    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }

    .caret {
      transition: transform 0.2s ease-in-out;
      flex-shrink: 0;
    }
    :global([dir='rtl']) .caret {
      transform: rotateZ(180deg);
    }
    [open] > summary .caret {
      transform: rotateZ(90deg);
    }

    a {
      display: block;
      border-radius: 0.25rem;
      text-decoration: none;
      color: var(--sl-color-gray-1);
      padding: 0.3em var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
    }

    a.two-line {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      padding-block: 0.4em;
    }

    a.two-line .link-label {
      font-family: var(--sl-font-mono);
      font-size: var(--sl-text-sm);
      color: var(--sl-color-white);
    }

    a.two-line .link-description {
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-1);
      line-height: 1.3;
    }

    a:hover,
    a:focus {
      color: var(--sl-color-white);
    }

    a.two-line:hover .link-description,
    a.two-line:focus .link-description {
      color: var(--sl-color-white);
    }

    a > *:not(:last-child),
    .group-label > *:not(:last-child) {
      margin-inline-end: 0.25em;
    }

    a.two-line > * {
      margin-inline-end: 0;
    }

    @media (min-width: 50rem) {
      .top-level > li + li {
        margin-top: 0.5rem;
      }
      .large {
        font-size: var(--sl-text-base);
      }
      a {
        font-size: var(--sl-text-sm);
      }
    }
  }
</style>
