---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const clipPathId = `makaio-site-clip-${crypto.randomUUID()}`;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <svg
    class="logo"
    viewBox="0 0 400 400"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Makaio logo"
  >
    <title>Makaio logo</title>
    <g transform="translate(200, 200)" stroke-width="24" stroke-linecap="round" fill="none">
      <path d="M -92 92 A 130 130 0 0 1 -92 -92" stroke="#8a2be2" opacity="0.8" />
      <path d="M -112.6 -65 A 130 130 0 0 1 112.6 -65" stroke="#00bfff" opacity="0.8" />
      <path d="M 92 -92 A 130 130 0 0 1 92 92" stroke="#ffd700" opacity="0.8" />
      <path d="M 120 50 A 130 130 0 0 1 0 130" stroke="#ff8c00" opacity="0.8" />
      <path d="M 50 120 A 130 130 0 0 1 -120 50" stroke="#ff1493" opacity="0.8" />
    </g>
    <g
      transform="translate(195, 195) scale(1.5)"
      stroke="#fff"
      stroke-width="9"
      stroke-linecap="round"
      fill="none"
    >
      <path d="M -42 35 L -42 -5 A 21 21 0 0 1 0 -5 L 0 35" />
      <g clip-path={`url(#${clipPathId})`}>
        <path d="M 4 -5 A 21 21 0 0 1 46 -5 L 46 35" />
      </g>
    </g>
    <defs>
      <clipPath id={clipPathId}>
        <rect x="14" y="-50" width="100" height="150" transform="rotate(-15 14 5)" />
      </clipPath>
    </defs>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .site-title:hover {
    color: var(--sl-color-white);
  }

  .logo {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.2));
    transition: filter 0.2s ease;
  }

  .site-title:hover .logo {
    filter: drop-shadow(0 0 12px rgba(245, 158, 11, 0.35));
  }

  span {
    overflow: hidden;
  }
</style>
