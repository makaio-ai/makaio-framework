{
  "name": "@makaio/electron",
  "version": "0.1.0",
  "private": true,
  "description": "Makaio desktop application",
  "author": "Makaio AI",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node --import tsx build.ts",
    "dev": "NODE_OPTIONS='--import tsx' electron ./src/main/main.ts",
    "dev:renderer": "NODE_OPTIONS='--import tsx/esm' vite --config vite.renderer.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts --configLoader runner",
    "build:all": "yarn build && yarn build:renderer",
    "package:dir": "tsx ../host-shared/src/build/prepare-framework-dist.ts && yarn build:all && electron-builder --dir",
    "package": "tsx ../host-shared/src/build/prepare-framework-dist.ts && yarn build:all && electron-builder"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@makaio/bus-core": "workspace:*",
    "@makaio/bus-transport-websocket": "workspace:*",
    "@makaio/cli": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/host-shared": "workspace:*",
    "@makaio/kernel": "workspace:*",
    "@makaio/preferences": "workspace:*",
    "@makaio/runtime-node": "workspace:*",
    "@makaio/services-core": "workspace:*",
    "@makaio/services-log-import": "workspace:*",
    "@makaio/services-package-manager": "workspace:*",
    "@makaio/storage-migrations": "workspace:*",
    "@makaio/ui-components": "workspace:*",
    "@makaio/ui-hooks": "workspace:*",
    "@makaio/ui-kernel": "workspace:*",
    "@makaio/ui-theme": "workspace:*",
    "@makaio/ui-views": "workspace:*",
    "@makaio/utils": "workspace:*",
    "hono": "^4.12.18",
    "lucide-react": "^0.562.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "yaml": "^2.9.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@makaio/bus-server-vite": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "39.8.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "get-port": "^7.0.0",
    "sass": "^1.97.3",
    "tsx": "^4.0.0",
    "vite": "^8.0.12"
  }
}
