{
  "name": "@makaio/electrobun",
  "version": "0.1.0",
  "private": true,
  "description": "Makaio desktop application — Electrobun (Bun-native) host",
  "author": "Makaio AI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun build.ts && electrobun dev",
    "dev:watch": "bun run build.ts && MAKAIO_ELECTROBUN_PKG_ROOT=\"$PWD\" electrobun dev --watch",
    "dev:renderer": "NODE_OPTIONS='--import tsx/esm' vite --config vite.renderer.config.ts",
    "build": "bun run build.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts --configLoader runner",
    "build:all": "yarn build && yarn build:renderer",
    "package": "yarn build:all && electrobun package",
    "package:base": "MAKAIO_VARIANT=base MAKAIO_RELEASE_TRACK=stable yarn build:all && MAKAIO_VARIANT=base MAKAIO_RELEASE_TRACK=stable electrobun build --env=stable",
    "package:cef": "MAKAIO_VARIANT=cef MAKAIO_RELEASE_TRACK=stable yarn build:all && MAKAIO_VARIANT=cef MAKAIO_RELEASE_TRACK=stable electrobun build --env=cef",
    "package:canary:base": "MAKAIO_VARIANT=base MAKAIO_RELEASE_TRACK=canary yarn build:all && MAKAIO_VARIANT=base MAKAIO_RELEASE_TRACK=canary electrobun build --env=canary",
    "package:canary:cef": "MAKAIO_VARIANT=cef MAKAIO_RELEASE_TRACK=canary yarn build:all && MAKAIO_VARIANT=cef MAKAIO_RELEASE_TRACK=canary electrobun build --env=cef-canary",
    "package:all-variants": "yarn package:base && yarn package:cef"
  },
  "dependencies": {
    "@makaio/bus-core": "workspace:*",
    "@makaio/bus-transport-websocket": "workspace:*",
    "@makaio/cli": "workspace:*",
    "@makaio/contracts": "workspace:*",
    "@makaio/host-shared": "workspace:*",
    "@makaio/kernel": "workspace:*",
    "@makaio/preferences": "workspace:*",
    "@makaio/runtime-bun": "workspace:*",
    "@makaio/services-core": "workspace:*",
    "@makaio/services-log-import": "workspace:*",
    "@makaio/services-package-manager": "workspace:*",
    "@makaio/storage-migrations": "workspace:*",
    "@makaio/ui-components": "workspace:*",
    "@makaio/ui-hooks": "workspace:*",
    "@makaio/ui-kernel": "workspace:*",
    "@makaio/ui-theme": "workspace:*",
    "@makaio/ui-views": "workspace:*",
    "@makaio/utils": "workspace:*",
    "dotenv": "^17.2.3",
    "electrobun": "^1.16.0",
    "hono": "^4.10.7",
    "lucide-react": "^0.562.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@makaio/bus-server": "workspace:*",
    "@makaio/bus-server-vite": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^5.1.2",
    "get-port": "^7.0.0",
    "sass": "^1.97.3",
    "tsx": "^4.0.0",
    "vite": "^8.0.0",
    "ws": "^8.16.0"
  }
}
